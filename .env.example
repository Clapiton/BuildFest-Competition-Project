# Supabase (https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
# service_role key for backend operations (bypasses RLS - keep private!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# anon key for frontend Supabase Auth operations
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_KEY=your-supabase-service-role-key # backwards compatibility

# Security & Environment
NODE_ENV=production
ADMIN_API_KEY=your-secure-admin-api-key # optional fallback/automation key
ALLOWED_ORIGINS=http://localhost:3000,https://buildfest-competition-project.onrender.com

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=sk-your-openai-api-key

# Redis — Upstash (free tier — https://upstash.com)
REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379

# Notification mode: "console" (default) or "email"
NOTIFICATION_MODE=console

# Resend API Key (free tier — https://resend.com)
RESEND_API_KEY=re_your_resend_api_key

# Support Team Target Email Addresses (for judges / testing)
# Set SUPPORT_TEAM_EMAIL to direct ALL routed & escalated emails to a single address:
SUPPORT_TEAM_EMAIL=judge-email@example.com

# Or set per-category email addresses individually:
# SUPPORT_BILLING_EMAIL=billing@example.com
# SUPPORT_PRODUCT_EMAIL=product@example.com
# SUPPORT_SERVICE_EMAIL=service@example.com
# SUPPORT_OTHER_EMAIL=other@example.com
# SUPPORT_MANAGER_EMAIL=manager@example.com

# SMTP (only needed if NOTIFICATION_MODE=email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password

# Server
PORT=3000

# Escalation delay in milliseconds (3 minutes for demo, represents 24h SLA)
ESCALATION_DELAY_MS=180000

# UptimeRobot Keep-Alive (free tier — https://uptimerobot.com)
APP_URL=https://your-app.onrender.com
UPTIMEROBOT_API_KEY=u1234567-xxxxxxxxxxxxxxxx

