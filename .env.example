# Supabase (free tier — https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key  # Use the service_role key (not anon) — found in Project Settings > API

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=sk-your-openai-api-key

# Redis — Upstash (free tier — https://upstash.com)
REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379

# Notification mode: "console" (default) or "email"
NOTIFICATION_MODE=console

# Resend API Key (free tier — https://resend.com)
RESEND_API_KEY=re_your_resend_api_key


# SMTP (only needed if NOTIFICATION_MODE=email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password

# Server
PORT=3000

# Escalation delay in milliseconds (3 minutes for demo, represents 24h SLA)
ESCALATION_DELAY_MS=180000

# UptimeRobot Keep-Alive (free tier — https://uptimerobot.com)
APP_URL=https://your-app.onrender.com
UPTIMEROBOT_API_KEY=u1234567-xxxxxxxxxxxxxxxx

